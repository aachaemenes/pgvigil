    {
      "id": 1,
      "type": "timeseries",
      "title": "Rows per second",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT snapshot_at AS time, round(sum(tup_returned)::numeric / max(interval_secs), 1) AS returned, round(sum(tup_fetched)::numeric / max(interval_secs), 1) AS fetched, round(sum(tup_inserted)::numeric / max(interval_secs), 1) AS inserted, round(sum(tup_updated)::numeric / max(interval_secs), 1) AS updated, round(sum(tup_deleted)::numeric / max(interval_secs), 1) AS deleted FROM pgvigil.dbstats_rate($instance, $__timeFrom(), $__timeTo()) WHERE interval_secs > 0 GROUP BY snapshot_at HAVING NOT bool_or(reset) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Block read and write time (track_io_timing)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT snapshot_at AS time, round((sum(blk_read_time) / max(interval_secs))::numeric, 3) AS read_ms_per_s, round((sum(blk_write_time) / max(interval_secs))::numeric, 3) AS write_ms_per_s, round((sum(blk_read_time) / nullif(sum(blks_read), 0))::numeric, 4) AS ms_per_block_read FROM pgvigil.dbstats_rate($instance, $__timeFrom(), $__timeTo()) WHERE interval_secs > 0 GROUP BY snapshot_at HAVING NOT bool_or(reset) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",

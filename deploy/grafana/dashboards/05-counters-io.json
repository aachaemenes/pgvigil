          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT metric, value, unit, stat, dim, source, at FROM pgvigil.cloud_io_latest WHERE instance_id = $instance ORDER BY metric, dim"

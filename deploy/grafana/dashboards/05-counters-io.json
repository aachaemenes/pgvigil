    {
      "id": 9,
      "type": "table",
      "title": "pg_stat_io by backend, object and context",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT backend_type, object, context, sum(reads) AS reads, sum(read_bytes) AS read_bytes, round((sum(read_time) / nullif(sum(reads), 0))::numeric, 3) AS ms_per_read, sum(writes) AS writes, sum(write_bytes) AS write_bytes, sum(extends) AS extends, sum(hits) AS hits, round(100.0 * sum(hits) / nullif(sum(hits) + sum(reads), 0), 1) AS hit_pct, sum(evictions) AS evictions, sum(fsyncs) AS fsyncs FROM pgvigil.iostats_rate($instance, $__timeFrom(), $__timeTo()) WHERE NOT reset GROUP BY backend_type, object, context HAVING coalesce(sum(reads), 0) + coalesce(sum(writes), 0) + coalesce(sum(extends), 0) + coalesce(sum(hits), 0) + coalesce(sum(fsyncs), 0) > 0 ORDER BY coalesce(sum(read_bytes), 0) + coalesce(sum(write_bytes), 0) DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },

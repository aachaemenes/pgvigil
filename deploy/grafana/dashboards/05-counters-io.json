            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT snapshot_at AS time, device || ' read' AS metric, read_bytes_s AS value FROM pgvigil.host_io_rate($instance, $__timeFrom(), $__timeTo()) WHERE interval_secs > 0 UNION ALL SELECT snapshot_at, device || ' write', write_bytes_s FROM pgvigil.host_io_rate($instance, $__timeFrom(), $__timeTo()) WHERE interval_secs > 0 ORDER BY 1, 2"

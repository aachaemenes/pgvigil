          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT v.instance_id, v.instance, c.check_name, c.object, c.value, c.unit, c.state, c.snapshot_at FROM pgvigil.replication_checks c JOIN pgvigil.versions_fleet v USING (instance_id) ORDER BY v.instance, c.check_name"

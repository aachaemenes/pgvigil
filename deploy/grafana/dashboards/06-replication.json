    {
      "id": 5,
      "type": "bargauge",
      "title": "Lag by stream (bytes)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT v.instance || ' ' || r.kind || ' ' || r.key AS stream, r.lag_bytes FROM pgvigil.replication_latest r JOIN pgvigil.versions_fleet v USING (instance_id) WHERE r.lag_bytes IS NOT NULL ORDER BY r.lag_bytes DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [],
          "fields": "",
          "values": true
        },
        "valueMode": "color"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Streams",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT v.instance_id, v.instance, r.kind, r.key, r.state, r.active, r.lag_bytes, round(r.lag_secs::numeric, 3) AS lag_secs, r.snapshot_at, r.detail::text AS detail FROM pgvigil.replication_latest r JOIN pgvigil.versions_fleet v USING (instance_id) ORDER BY v.instance, r.kind, r.key"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "instance"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Instance overview",
                    "url": "/d/pgvigil-instance?var-instance=${__data.fields.instance_id}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "instance_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },

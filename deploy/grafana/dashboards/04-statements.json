      "id": 1,
      "type": "bargauge",
      "title": "Top 10 by total execution time",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT left(regexp_replace(coalesce(query, queryid::text), '\\s+', ' ', 'g'), 90) AS statement, round(total_exec_ms::numeric, 0) AS total_ms FROM pgvigil.top_statements_by($instance, $__timeFrom(), $__timeTo(), 'time', 10) ORDER BY total_exec_ms DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [],
          "fields": "",
          "values": true
        },
        "valueMode": "color"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Top statements",
      "description": "The query text is what the collector stored under its query_text policy (full, normalized or none).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,

          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT queryid, datname, usename, calls, round(total_exec_ms::numeric, 1) AS total_ms, round(mean_exec_ms::numeric, 2) AS mean_ms, rows, hit_pct, io_blks, round(blk_read_ms::numeric, 1) AS blk_read_ms, temp_blks_written, wal_bytes, query FROM pgvigil.top_statements_by($instance, $__timeFrom(), $__timeTo(), '$order', $limit)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },

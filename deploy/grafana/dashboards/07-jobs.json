    {
      "id": 7,
      "type": "table",
      "title": "Jobs",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT instance_id, instance, scheduler, job_name, schedule, datname, run_as, active, last_status, last_start, last_duration_secs, runs_7d, failures_7d, fail_streak, avg_7d_secs, max_7d_secs, over_average, missed, next_run, last_message FROM pgvigil.job_report WHERE is_present ORDER BY fail_streak DESC, failures_7d DESC, instance, job_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "instance"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Instance overview",
                    "url": "/d/pgvigil-instance?var-instance=${__data.fields.instance_id}&${__url_time_range}&${datasource:queryparam}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "instance_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Failed runs in the range",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT v.instance_id, v.instance, f.scheduler, f.job_name, f.status, f.start_time, f.end_time, round(f.duration_secs::numeric, 1) AS duration_secs, f.return_message FROM pgvigil.job_failures f JOIN pgvigil.versions_fleet v USING (instance_id) WHERE f.start_time BETWEEN $__timeFrom() AND $__timeTo() ORDER BY f.start_time DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "inspect": true
          }

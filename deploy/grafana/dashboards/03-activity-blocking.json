    {
      "id": 7,
      "type": "table",
      "title": "Blocking chains (latest snapshot)",
      "description": "The head is the session that holds and waits on no lock itself: its transaction and last statement are the cause.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT head_pid, depth, pid, state, wait_event, in_cycle, head_state, head_backend_type, head_query, waiter_query FROM pgvigil.blocking_chains($instance, (SELECT max(snapshot_at) FROM pgvigil.activity_latest WHERE instance_id = $instance)) ORDER BY head_pid, depth, pid"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Lock tree at the range's end",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT snapshot_at, top_blocker, level, pid, blocked_by::text AS blocked_by, blocked, state, wait, xact_start, query_start, datname, usename, application_name FROM pgvigil.lock_tree($instance, $__timeTo()) ORDER BY path"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Sessions (latest snapshot)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT pid, datname, usename, application_name, client, state, coalesce(wait_event_type || ':' || wait_event, '') AS wait, extract(epoch FROM snapshot_at - xact_start)::int AS xact_secs, extract(epoch FROM snapshot_at - CASE WHEN state = 'active' THEN query_start ELSE state_change END)::int AS state_secs, blocking_pids::text AS blocked_by, is_blocker, backend_xmin_age, backend_type, query_id FROM pgvigil.activity_latest WHERE instance_id = $instance ORDER BY is_blocker DESC, cardinality(blocking_pids) DESC, xact_start NULLS LAST"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Long-running statements in the range (5 s and over)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT first_seen, last_seen, at_least_secs, pid, state, datname, usename, application_name, top_wait, was_blocked, was_blocker, query FROM pgvigil.slow_in_window($instance, $__timeFrom(), $__timeTo(), 5, 100) ORDER BY at_least_secs DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Connections",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT snapshot_at AS time, sum(numbackends) AS connections FROM pgvigil.dbstats_rate($instance, $__timeFrom(), $__timeTo()) GROUP BY snapshot_at HAVING NOT bool_or(reset) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {

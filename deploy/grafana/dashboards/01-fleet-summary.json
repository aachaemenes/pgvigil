          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT v.instance_id, v.instance, f.severity, f.source, f.setting AS \"check\", f.value, f.detail, f.suggested, f.at FROM pgvigil.findings f JOIN pgvigil.versions_fleet v USING (instance_id) WHERE f.severity IN ('critical', 'warning') ORDER BY CASE f.severity WHEN 'critical' THEN 0 WHEN 'warning' THEN 1 ELSE 2 END, v.instance, f.setting"
        }

    {
      "id": 7,
      "type": "table",
      "title": "Instances",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT v.instance_id, v.instance, v.platform, v.server_version, v.last_restart, coalesce(f.critical, 0) AS critical, coalesce(f.warning, 0) AS warning, coalesce(a.sessions, 0) AS sessions, coalesce(a.blocked, 0) AS blocked, b.archiver_failing, c.data_checksums, c.events_7d AS corruption_events_7d, v.pending_actions FROM pgvigil.versions_fleet v LEFT JOIN (SELECT instance_id, count(*) FILTER (WHERE severity = 'critical') AS critical, count(*) FILTER (WHERE severity = 'warning') AS warning FROM pgvigil.findings GROUP BY instance_id) f USING (instance_id) LEFT JOIN (SELECT instance_id, count(*) AS sessions, count(*) FILTER (WHERE cardinality(blocking_pids) > 0) AS blocked FROM pgvigil.activity_latest GROUP BY instance_id) a USING (instance_id) LEFT JOIN pgvigil.backup_status b USING (instance_id) LEFT JOIN pgvigil.corruption_summary c USING (instance_id) ORDER BY critical DESC, warning DESC, v.instance"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "instance"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Instance overview",
                    "url": "/d/pgvigil-instance?var-instance=${__data.fields.instance_id}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "instance_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Critical and warning findings",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"

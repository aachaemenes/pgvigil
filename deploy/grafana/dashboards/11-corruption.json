            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(sum(amcheck_corrupt), 0) AS corrupt FROM pgvigil.corruption_summary"

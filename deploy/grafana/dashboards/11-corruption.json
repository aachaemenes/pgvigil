    },
    {
      "id": 8,
      "type": "table",
      "title": "Corruption findings",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT v.instance_id, v.instance, f.severity, f.setting AS \"check\", f.value, f.detail, f.suggested FROM pgvigil.corruption_findings f JOIN pgvigil.versions_fleet v USING (instance_id) ORDER BY CASE f.severity WHEN 'critical' THEN 0 WHEN 'warning' THEN 1 ELSE 2 END, v.instance"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "inspect": true
          }
        },

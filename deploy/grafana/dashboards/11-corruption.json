      "id": 3,
      "type": "stat",
      "title": "amcheck: corrupt objects",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,

# PGAUTH WIRING (the lead's at the join; never applied by the slice): web/src/admin_instances.ts's PostgreSQL sign-in
# kinds on the instance form - the 'password' kind says it serves a directory account too (LDAP, RADIUS, PAM: M1, with
# sslmode=verify-full, docs/postgres-signin.md), and the 'kerberos' kind (M3: the process's own Kerberos identity,
# pgvigil.yaml's kerberos: block; the login is the role; BuildDSN and the page door take it on rel-pgauth).
diff --git a/web/src/admin_instances.ts b/web/src/admin_instances.ts
index 245673e99..4fa5ea643 100644
--- a/web/src/admin_instances.ts
+++ b/web/src/admin_instances.ts
@@ -80,7 +80,8 @@ function select(name: string, opts: [string, string][], value = ''): HTMLSelectE
 const authOpts = (engine: string): [string, string][] => engine === 'sqlserver'
   ? [['sql', 'SQL login'], ['windows', 'Windows account (the service\'s own; off Windows a Kerberos keytab or cache)'], ['entra', 'Entra service principal'],
     ['entra-identity', 'Entra managed identity (this host\'s own, no secret)']]
-  : [['password', 'login and password'], ['pgpass', 'the service account\'s .pgpass']];
+  : [['password', 'login and password (a directory account too: LDAP, RADIUS, PAM - with sslmode=verify-full)'], ['pgpass', 'the service account\'s .pgpass'],
+    ['kerberos', 'Kerberos (this host\'s own identity: pgvigil.yaml\'s kerberos: block; the login is the role)']];
 const platOpts = (engine: string): [string, string][] => engine === 'sqlserver'
   ? [['auto', 'auto'], ['onprem', 'on premises'], ['rds', 'Amazon RDS'], ['azuresqldb', 'Azure SQL Database'], ['azuresqlmi', 'Azure SQL Managed Instance'], ['cloudsql', 'Google Cloud SQL']]
   : [['auto', 'auto'], ['onprem', 'on premises'], ['rds', 'Amazon RDS'], ['aurora', 'Aurora'], ['azure', 'Azure'], ['cloudsql', 'Cloud SQL'], ['alloydb', 'AlloyDB']];

diff --git i/internal/repo/mi_backups_test.go w/internal/repo/mi_backups_test.go
index 693bf78..bc8d23d 100644
--- i/internal/repo/mi_backups_test.go
+++ w/internal/repo/mi_backups_test.go
@@ -55,6 +55,50 @@ func TestBackupJudged0129Is0066PlusManagedInstance(t *testing.T) {
 	}
 }
 
+// 0156 (task 405, Changed 46) re-creates mssql_backup_judged judged by mssql_protection_limits (Admin's tag and
+// database ages): with the resolver taken back out (the two ages from the limits view again, its LATERAL join and the
+// two appended columns gone) 0156's view is 0129's, character for character.
+func TestBackupJudged0156Is0129PlusResolver(t *testing.T) {
+	view := func(file string) string {
+		t.Helper()
+		b, err := migrations.ReadFile("sql/" + file)
+		if err != nil {
+			t.Fatal(err)
+		}
+		s := string(b)
+		i := strings.Index(s, "CREATE OR REPLACE VIEW pgvigil.mssql_backup_judged AS")
+		if i < 0 {
+			t.Fatalf("%s: no mssql_backup_judged", file)
+		}
+		j := strings.Index(s[i:], "  FROM j;")
+		if j < 0 {
+			t.Fatalf("%s: mssql_backup_judged has no end", file)
+		}
+		return s[i : i+j]
+	}
+	got := view("0156_pm313_rules.sql")
+	for _, r := range [][2]string{
+		{"pl.full_backup_hours, l.diff_backup_hours, pl.log_backup_minutes,", "l.full_backup_hours, l.diff_backup_hours, l.log_backup_minutes,"},
+		{"AS excluded_by,\n         pl.full_from AS full_hours_from, pl.log_from AS log_minutes_from\n", "AS excluded_by\n"},
+		{"    CROSS JOIN LATERAL pgvigil.mssql_protection_limits(s.instance_id, s.database_name) pl\n", ""},
+		{",\n       -- where each age the database is judged by comes from (0156: an override, pgvigil.yaml or the default)\n       j.full_hours_from, j.log_minutes_from", ""},
+	} {
+		if strings.Count(got, r[0]) != 1 {
+			t.Fatalf("0156's mssql_backup_judged holds %q %d times, want once", r[0], strings.Count(got, r[0]))
+		}
+		got = strings.Replace(got, r[0], r[1], 1)
+	}
+	if want := view("0129_mssql_mi_backups.sql"); got != want {
+		gl, wl := strings.Split(got, "\n"), strings.Split(want, "\n")
+		for k := 0; k < len(gl) && k < len(wl); k++ {
+			if gl[k] != wl[k] {
+				t.Fatalf("0156's mssql_backup_judged differs from 0129's beyond the resolver at its line %d:\n0156: %s\n0129: %s", k+1, gl[k], wl[k])
+			}
+		}
+		t.Fatalf("0156's mssql_backup_judged has %d lines, 0129's %d", len(gl), len(wl))
+	}
+}
+
 // On a migrated store (PGVIGIL_REPO_TEST_DSN, skipped without it): a Managed Instance's master, model and msdb are
 // not judged, with Microsoft's reason, and its user database is judged as anywhere; on a server someone runs, model
 // with no backup is still 'never'.
diff --git i/internal/repo/sql/0190_join_release2.sql w/internal/repo/sql/0190_join_release2.sql
index 40526c2..fb9c47a 100644
--- i/internal/repo/sql/0190_join_release2.sql
+++ w/internal/repo/sql/0190_join_release2.sql
@@ -698,3 +698,120 @@ SELECT j.instance_id, j.dbid, j.datname, j.is_template, j.snapshot_at, j.platfor
             WHEN 'warn' IN (j.conn_status, j.allow_status, j.encoding_status, j.collation_status, j.checksums_status, j.xid_status) THEN 'warn'
             ELSE 'ok' END AS worst
   FROM j;
+
+-- task 405 (PerformanceMonitor 3.13's moved rules, WIRING of 0156): darling_alert_findings is 0118's view with its
+-- runnable arm reading 0156's mssql_runnable_queue (the 5-minute window, else the newest 3 reads within the fallback
+-- window: Changed 13) and one more arm, the PostgreSQL poison wait (Changed 19). Every other arm as 0118 has it.
+CREATE OR REPLACE VIEW pgvigil.darling_alert_findings AS
+SELECT t.instance_id, CASE WHEN t.n_dead_tup >= 10000000 THEN 'critical' ELSE 'warning' END AS severity,
+       'dead tuples piling up'::text AS setting, t.datname || '.' || t.schema_name || '.' || t.table_name AS value, true AS is_set,
+       'under 1000000 dead tuples'::text AS suggested, 'all'::text AS platforms,
+       format('%s dead tuples beside %s live ones at the last read; the last autovacuum %s: autovacuum is behind on this table (a long transaction, an idle-in-transaction session or a slot can hold its cleanup back)',
+              t.n_dead_tup, coalesce(t.n_live_tup, 0), coalesce(to_char(t.last_autovacuum, 'YYYY-MM-DD HH24:MI'), 'never')) AS detail,
+       'pg-collector'::text AS source, t.snapshot_at AS at
+  FROM pgvigil.tables t
+ WHERE t.is_present AND t.n_dead_tup >= 1000000 AND t.snapshot_at > now() - interval '1 day'
+UNION ALL
+SELECT r.instance_id, CASE WHEN r.lag_secs >= 300 THEN 'critical' ELSE 'warning' END, 'replay lag', r.key, true,
+       'under 30 s', 'all', format('the standby %s replays %s s behind the primary', r.key, round(r.lag_secs::numeric, 1)),
+       'pg-collector', r.snapshot_at
+  FROM pgvigil.replication_latest r
+ WHERE r.kind = 'sender' AND r.lag_secs >= 30 AND r.snapshot_at > now() - interval '15 minutes'
+UNION ALL
+SELECT s.instance_id, CASE WHEN s.lag_bytes >= 50 * 1073741824::bigint THEN 'critical' ELSE 'warning' END, 'replication slot retaining WAL', s.key, true,
+       'under 10 GB', 'all',
+       format('the slot %s retains %s of WAL and %s: WAL a slot keeps is unbounded unless max_slot_wal_keep_size is set, so it fills the volume; a slot whose consumer is gone is dropped',
+              s.key, pg_size_pretty(s.lag_bytes), CASE WHEN coalesce(s.active, false) THEN 'its consumer is connected' ELSE 'its consumer is not connected' END),
+       'pg-collector', s.snapshot_at
+  FROM pgvigil.replication_latest s
+ WHERE s.kind = 'slot' AND s.lag_bytes >= 10 * 1073741824::bigint AND s.snapshot_at > now() - interval '15 minutes'
+UNION ALL
+SELECT v.instance_id, CASE WHEN v.free_bytes <= 2 * 1073741824::bigint THEN 'critical' ELSE 'warning' END, 'a volume under 5 GB free', v.drive, true,
+       'over 5 GB free', 'all',
+       format('%s free of %s (%s %%); %s database file(s) sit on it; its percent threshold (warning under %s %%, critical under %s %%) raises nothing, so the 5 GB floor judges it',
+              pg_size_pretty(v.free_bytes), pg_size_pretty(v.total_bytes), v.free_pct, v.files, v.warn_pct, v.crit_pct),
+       'mssql_storage', v.snapshot_at
+  FROM pgvigil.drives_now v
+ WHERE v.source = 'dm_os_volume_stats' AND v.status = 'ok' AND v.free_bytes < 5 * 1073741824::bigint
+   AND v.snapshot_at > now() - interval '3 hours' AND v.total_bytes > 10 * 1073741824::bigint
+UNION ALL
+SELECT d.instance_id, 'warning', 'AG secondary behind', d.group_name || ': ' || d.database_name || ' on ' || d.replica_server, true,
+       'under 300 s', 'all',
+       format('Availability Group %s: database %s on replica %s is %s seconds behind the primary (threshold 300)', d.group_name, d.database_name, d.replica_server, d.secondary_lag_s),
+       'mssql_hadr', d.snapshot_at
+  FROM pgvigil.mssql_ag_database_state d
+ WHERE d.secondary_lag_s >= 300 AND d.snapshot_at > now() - interval '30 minutes'
+UNION ALL
+SELECT i.instance_id, CASE WHEN q.per_sched >= 16 THEN 'critical' ELSE 'warning' END, 'runnable queue per scheduler', 'schedulers', true,
+       'under 8 per scheduler', 'all',
+       format('runnable tasks averaged %s per scheduler over %s (%s schedulers): work waits for a CPU',
+              round(q.per_sched, 1), q.window_text, q.schedulers),
+       'mssql_perf', q.at
+  FROM pgvigil.instances i
+  CROSS JOIN LATERAL pgvigil.mssql_runnable_queue(i.instance_id, now()) q
+ WHERE i.engine = 'sqlserver' AND q.per_sched >= 8
+UNION ALL
+SELECT l.instance_id, 'warning', 'long-running requests', 'requests', true, 'under 30 minutes', 'all',
+       format('%s request(s) running 30 minutes or more, the longest %s min: session %s (%s, login %s, program %s)', l.n, l.longest_min, l.session_id,
+              coalesce(l.command, 'command unknown'), coalesce(l.login_name, '(unknown)'), coalesce(nullif(l.program_name, ''), '(none)')),
+       'mssql_running', l.snapshot_at
+  FROM (SELECT r.instance_id, r.snapshot_at, count(*) OVER (PARTITION BY r.instance_id) AS n, r.elapsed_ms / 60000 AS longest_min,
+               r.session_id, r.command, r.login_name, r.program_name,
+               row_number() OVER (PARTITION BY r.instance_id ORDER BY r.elapsed_ms DESC) AS k
+          FROM pgvigil.mssql_requests r
+          JOIN (SELECT instance_id, max(snapshot_at) AS at FROM pgvigil.mssql_requests_summary WHERE snapshot_at > now() - interval '10 minutes' GROUP BY instance_id) m
+            ON m.instance_id = r.instance_id AND m.at = r.snapshot_at
+         WHERE r.snapshot_at > now() - interval '10 minutes'      -- the day partitions pruned whatever the join's plan
+           AND r.request_id IS NOT NULL AND r.session_id > 50 AND r.elapsed_ms >= 1800000
+           AND coalesce(upper(r.command), '') NOT LIKE 'BACKUP%' AND coalesce(upper(r.command), '') NOT LIKE 'RESTORE%'
+           AND coalesce(upper(r.wait_type), '') NOT IN ('BACKUPTHREAD', 'BACKUPIO', 'SP_SERVER_DIAGNOSTICS_SLEEP', 'WAITFOR', 'BROKER_RECEIVE_WAITFOR', 'XE_LIVE_TARGET_TVF')
+           AND coalesce(upper(r.wait_type), '') NOT LIKE '%SP_SERVER_DIAGNOSTICS%'
+           AND coalesce(r.program_name, '') NOT LIKE 'SQLAgent - TSQL JobStep%'
+           AND coalesce(upper(r.login_name), '') NOT IN ('NT AUTHORITY\SYSTEM', 'NT AUTHORITY\NETWORK SERVICE')) l
+ WHERE l.k = 1
+UNION ALL
+SELECT c.instance_id, 'critical', 'server unreachable', i.name, true, 'answering and accepting the collector''s login', 'all',
+       format('the newest read of %s (%s, %s) could not connect: %s', i.name, c.collection, to_char(c.snapshot_at, 'YYYY-MM-DD HH24:MI:SS'), substr(c.note, 10)),
+       'collector', c.snapshot_at
+  FROM (SELECT DISTINCT ON (d.instance_id) d.* FROM pgvigil.collection_dates d ORDER BY d.instance_id, d.snapshot_at DESC) c
+  JOIN pgvigil.instances i USING (instance_id)
+ WHERE i.is_active AND c.status = 'error' AND c.snapshot_at > now() - interval '30 minutes'
+   AND c.note LIKE 'connect: %';
+
+-- import_connect_failure: a collection that could not connect to its instance, recorded as that collection's error with
+-- the note 'connect: <the driver's error>'. An instance with no row - one of pgvigil.yaml never reached (its row is
+-- made at its first read that connects) - gets its row here with the configuration's engine, platform and tags, so
+-- it is reported as any instance that cannot be reached (the join's w9e, finding 7); not when the page removed the
+-- name in the last 5 minutes (a read in flight of a removed page instance). A retired row (is_active false: removed,
+-- disabled) is left alone. The collector's door (an import_ function: apply_roles makes it SECURITY DEFINER and the
+-- collector's).
+DROP FUNCTION IF EXISTS pgvigil.import_connect_failure(text, text, timestamptz, int, text);
+CREATE OR REPLACE FUNCTION pgvigil.import_connect_failure(p_name text, p_collection text, p_at timestamptz, p_duration_ms int, p_error text,
+                                                          p_engine text DEFAULT NULL, p_platform text DEFAULT NULL, p_tags text[] DEFAULT NULL)
+RETURNS void LANGUAGE plpgsql AS $$
+DECLARE v_id int; v_active boolean;
+BEGIN
+  -- the row of this engine only: a read of the other engine in flight (a name removed and added again with the other
+  -- engine) writes nothing onto it (the fold's review, finding 2)
+  SELECT i.instance_id, i.is_active INTO v_id, v_active FROM pgvigil.instances i WHERE i.name = p_name AND (p_engine IS NULL OR i.engine = p_engine);
+  IF v_id IS NULL THEN
+    IF coalesce(p_engine, '') NOT IN ('postgres', 'sqlserver')
+       OR EXISTS (SELECT 1 FROM pgvigil.admin_removed r WHERE r.name = p_name AND r.removed_at > now() - interval '5 minutes') THEN
+      RETURN;
+    END IF;
+    INSERT INTO pgvigil.instances (name, platform, engine, tags)
+    VALUES (p_name, coalesce(nullif(p_platform, ''), 'auto'), p_engine, coalesce(p_tags, '{}'))
+    ON CONFLICT (name) DO NOTHING;
+    SELECT i.instance_id, i.is_active INTO v_id, v_active FROM pgvigil.instances i WHERE i.name = p_name AND i.engine = p_engine;
+  END IF;
+  IF v_id IS NULL OR NOT v_active THEN RETURN; END IF;
+  PERFORM pgvigil.log_collection(v_id, p_collection, p_at, p_duration_ms, 'error', 'connect: ' || left(coalesce(nullif(p_error, ''), 'no reason given'), 2000));
+END $$
+UNION ALL
+-- task 405 (Changed 19): the PostgreSQL poison wait (0156's pg_poison_wait_findings, wait_sample only); its info row
+-- 'not judged: needs pg_wait_sampling' is the page's, not an alert
+SELECT i.instance_id, p.severity, 'poison wait', p.object, true, 'under 1.0 waiting backends on average', 'all', p.detail, 'pg-collector', p.at
+  FROM pgvigil.instances i
+  CROSS JOIN LATERAL pgvigil.pg_poison_wait_findings(i.instance_id, now()) p
+ WHERE i.engine = 'postgres' AND i.is_active AND p.severity IN ('warning', 'critical');
+COMMENT ON VIEW pgvigil.darling_alert_findings IS 'PerformanceMonitor''s alert defaults as findings (task 177 D30, task 405): dead tuples, replay lag, slot WAL, a volume under 5 GB free, an AG secondary behind, the runnable queue per scheduler, long-running requests, a server unreachable, the PostgreSQL poison wait.';

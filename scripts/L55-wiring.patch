new file mode 100644
index 000000000..81b21d167
--- /dev/null
+++ w/internal/web/apipaths_l55_test.go
@@ -0,0 +1,31 @@
+package web
+
+import (
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"testing"
+)
+
+// TestNoAbsoluteAPIPathsL55 (RELNOTES L55, the lead's 00:47): every /api fetch and link in the UI goes through apiURL
+// (web/src/api.ts), so a page served under web.base_path reads under it; a new absolute /api/ path in a string in
+// web/src fails here, naming its file and line.
+func TestNoAbsoluteAPIPathsL55(t *testing.T) {
+	files, err := filepath.Glob(filepath.Join("..", "..", "web", "src", "*.ts"))
+	if err != nil || len(files) == 0 {
+		t.Fatalf("web/src: %v (%d files)", err, len(files))
+	}
+	abs := regexp.MustCompile("['\"`]/api/")
+	for _, f := range files {
+		b, err := os.ReadFile(f)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for i, line := range strings.Split(string(b), "\n") {
+			if abs.MatchString(line) {
+				t.Errorf("%s:%d: an absolute /api/ path - write apiURL(...) (web/src/api.ts): %s", filepath.Base(f), i+1, strings.TrimSpace(line))
+			}
+		}
+	}
+}

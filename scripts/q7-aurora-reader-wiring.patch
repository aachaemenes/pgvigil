# WIRING for the lead (task 374 / Q7, the lead 06:2x): on platform aurora the rolechange and backups collectors skip the
# calls a real Aurora PostgreSQL 17.9 reader rejects (SQLSTATE 0A000: pg_stat_get_wal_receiver, pg_last_wal_receive_lsn,
# pg_last_wal_replay_lsn) and say so in the collection log; collect.go keeps collector_note rows out of the import (aurora_sql_test.go pins the Aurora SQL).
# Apply with git apply; judged by scripts/proof-pg-hadr.sh row AF2.
diff --git c/internal/collect/aurora_sql_test.go i/internal/collect/aurora_sql_test.go
new file mode 100644
index 00000000..09db3be0
--- /dev/null
+++ i/internal/collect/aurora_sql_test.go
@@ -0,0 +1,22 @@
+package collect
+
+import (
+	"strings"
+	"testing"
+)
+
+// TestAuroraSQLLeavesOutRejectedCalls: the Aurora variants of the rolechange and backups reads leave out every call a
+// real Aurora PostgreSQL 17.9 reader rejects (SQLSTATE 0A000, proof-pg-aurora.sh's Q7 lab run 2); a strings.Replace
+// that matched nothing would bring the failure back silently.
+func TestAuroraSQLLeavesOutRejectedCalls(t *testing.T) {
+	if backupsArchiverAuroraSQL == backupsArchiverSQL {
+		t.Fatal("backupsArchiverAuroraSQL equals backupsArchiverSQL: the replace matched nothing")
+	}
+	for name, q := range map[string]string{"backupsArchiverAuroraSQL": backupsArchiverAuroraSQL, "roleBaseAuroraSQL": roleBaseAuroraSQL} {
+		for _, f := range []string{"pg_last_wal_receive_lsn", "pg_last_wal_replay_lsn", "pg_last_xact_replay_timestamp", "pg_is_wal_replay_paused", "pg_stat_wal_receiver"} {
+			if strings.Contains(q, f) {
+				t.Errorf("%s calls %s, which Aurora rejects", name, f)
+			}
+		}
+	}
+}

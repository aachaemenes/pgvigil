+// hoursSet is one '<table>=<days>' of -hours.
+type hoursSet struct {
+	table string
+	days  int
+}
+
+// parseHoursFlag reads -hours: '<table>=<days>' pairs separated by commas, each table a plain lower-case name and its
+// days 1 or more.
+func parseHoursFlag(v string) ([]hoursSet, error) {
+	var out []hoursSet
+	for _, part := range strings.Split(v, ",") {
+		t, d, ok := strings.Cut(strings.TrimSpace(part), "=")
+		n, err := strconv.Atoi(strings.TrimSpace(d))
+		t = strings.TrimSpace(t)
+		if !ok || err != nil || n < 1 || t == "" || strings.Trim(t, "abcdefghijklmnopqrstuvwxyz0123456789_") != "" {
+			return nil, fmt.Errorf("-hours wants <table>=<days> with days 1 or more (job_stats_hourly=730), not %q", part)
+		}
+		out = append(out, hoursSet{t, n})
+	}
+	return out, nil
+}

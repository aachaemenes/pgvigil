diff --git i/internal/repo/sql/0199_proof_d03_join.sql w/internal/repo/sql/0199_proof_d03_join.sql
new file mode 100644
index 0000000..2f95315
--- /dev/null
+++ w/internal/repo/sql/0199_proof_d03_join.sql
@@ -0,0 +1,11 @@
+-- PROOF ONLY (scripts/proof-darling-waits.sh applies it to its own copy of the tree): the join's arm of task 177 D03 in
+-- pgvigil.findings, appended to whatever pgvigil.findings the tree defines. The join itself writes the arm into its
+-- join file as text:
+--     SELECT instance_id, severity, check_name, object, NULL::boolean, NULL::text, NULL::text, detail, 'mssql_waits', at
+--       FROM pgvigil.mssql_waits_findings
+DO $$
+DECLARE v text := rtrim(pg_get_viewdef('pgvigil.findings'::regclass), E' ;\n');
+BEGIN
+  EXECUTE 'CREATE OR REPLACE VIEW pgvigil.findings AS SELECT * FROM (' || v || E') f\nUNION ALL\n'
+       || 'SELECT instance_id, severity, check_name, object, NULL::boolean, NULL::text, NULL::text, detail, ''mssql_waits''::text, at FROM pgvigil.mssql_waits_findings';
+END $$;
